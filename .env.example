# Neo4j password. Used by docker compose to create the database, by graph-sync to
# write and by mcp-server to read. Pick anything long; the graph is local-only.
NEO4J_PASSWORD=

# Optional. Defaults shown.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j

# Vaults to index, as name=path pairs separated by commas. Each name becomes the
# `source` on its nodes, so vaults can be re-synced independently and links never
# resolve across them. Defaults to the bundled example-vault.
# GRAPH_SOURCES=brain=/path/to/vault,shared=/path/to/team-vault

# Slugs of machine-generated notes, exempt from the orphan and level: rules.
# GRAPH_GENERATED=builds/pipeline-snapshot

# Where the Neo4j container keeps its data. Keep it out of any synced folder.
# GRAPH_DATA_DIR=./.neo4j
